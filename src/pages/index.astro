---
import Layout from '../layouts/Layout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import StatStrip from '../components/StatStrip.astro';
import CTASection from '../components/CTASection.astro';
import HeroFunnel from '../components/HeroFunnel.astro';
import FunnelStages from '../components/FunnelStages.astro';
import FunnelCalculator from '../components/FunnelCalculator.astro';
import ToolIcon from '../components/ToolIcon.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../lib/schema';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const caseStudies = (await getCollection('caseStudies')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
const author = (await getCollection('authors'))[0];

const industryLabels: Record<string, string> = {
	'industrial-equipment-machinery': 'Industrial Equipment & Machinery',
	'process-filtration': 'Process & Filtration',
	'life-sciences-lab-equipment': 'Life Sciences & Lab Equipment',
	'construction-heavy-equipment': 'Construction & Heavy Equipment',
};

const stageServices = (stage: 'ToFu' | 'MoFu' | 'BoFu') =>
	services.filter((s) => s.data.funnelStages.includes(stage)).map((s) => ({ id: s.id, title: s.data.title }));

const timeline = [
	{ era: '1920s — Print', body: 'Newspapers and direct mail built awareness. Salesmen closed the deal.' },
	{ era: '1950s — Radio', body: 'Jingles owned consideration. Door-to-door owned conversion.' },
	{ era: '1980s — Television', body: 'Mass awareness at scale. Retail closed.' },
	{ era: '2005 — Search', body: 'Google owned intent. Forms captured demand.' },
	{ era: '2015 — Social', body: 'Discovery moved to feeds. Retargeting closed.' },
	{ era: '2026 — AI / LLMs', body: 'Buyers ask ChatGPT, Perplexity, and Gemini. The funnel compresses but doesn’t disappear.' },
];

const manufacturingCards = [
	{ title: '9-Month Sales Cycles', body: 'We design content that nurtures over quarters, not clicks.' },
	{ title: 'Technical Buyer Personas', body: 'Process engineers, plant heads, procurement — each searches differently. We map every persona to every funnel stage.' },
	{ title: 'Distributor & Channel Conflict', body: 'Your dealer network shouldn’t compete with your brand on search. We solve channel conflict at the SERP level.' },
	{ title: 'Low-Volume, High-Intent Queries', body: '50 searches a month can drive ₹1Cr in revenue. We rank for the queries your CFO cares about, not the ones that look good in screenshots.' },
];

const marquee = ['Industrial SEO', 'Generative Engine Optimization', 'Answer Engine Optimization', 'Revenue attribution', 'Process & Filtration', 'Life Sciences', 'Construction & Heavy Equipment', 'Machinery & Equipment', 'Dealer-aware local SEO', 'Pipeline, not traffic'];
---

<Layout
	title="Funneling Revenue — SEO & GEO Agency for Manufacturers | Revenue-First Digital Marketing"
	description="We engineer revenue funnels for industrial and manufacturing brands — SEO, Generative Engine Optimization, and AI-first marketing built around pipeline, not vanity metrics."
	path="/"
	schema={[breadcrumbSchema([{ name: 'Home', path: '/' }])]}
>
	<!-- Hero -->
	<section class="hero">
		<div class="glow" aria-hidden="true"></div>
		<div class="container-max hero-grid">
			<div class="hero-inner">
				<p class="eyebrow" data-reveal>Revenue-first marketing for manufacturers</p>
				<h1 data-reveal>The Funnel Is Eternal. The Medium Isn&rsquo;t.</h1>
				<p class="rotor" data-reveal>
					We engineer <span class="grad-text" data-rotate="pipeline|qualified leads|AI citations|revenue">pipeline</span>.
				</p>
				<p class="sub" data-reveal>
					Revenue-first SEO, GEO, and digital marketing — built for manufacturers and industrial brands. We don&rsquo;t sell traffic.
				</p>

				<form class="url-cta" action="/tools/website-revenue-audit/" method="get" data-reveal>
					<label for="hero-url" class="sr-only">Your website address</label>
					<input id="hero-url" name="url" class="field-input" type="text" inputmode="url" autocomplete="url" autocapitalize="off" placeholder="Paste your website, e.g. yourcompany.com" required />
					<button type="submit" class="btn btn-accent">Audit my site free</button>
				</form>
				<p class="micro" data-reveal>Instant 0–100 revenue-readiness score. No sign-up.</p>

				<div class="hero-actions" data-reveal>
					<a href="/audit/" class="btn btn-secondary">Book a free revenue audit</a>
					<a href="/case-studies/industrial-revenue-recovery/" class="btn btn-ghost">See the ₹3Cr case study &rarr;</a>
				</div>
			</div>
			<div class="hero-art" data-reveal="zoom">
				<HeroFunnel />
			</div>
		</div>

		<div class="container-max proof-row">
			<div data-reveal><b data-count>₹3Cr+</b><span>delivered in 90 days</span></div>
			<div data-reveal><b data-count>200%</b><span>organic traffic growth</span></div>
			<div data-reveal><b data-count>8+</b><span>years in B2B &amp; industrial</span></div>
			<div data-reveal><b data-count>4,000+</b><span>keywords optimised</span></div>
		</div>
	</section>

	<div class="marquee band" aria-hidden="true">
		<div class="marquee-track">
			{[...marquee, ...marquee].map((m) => <span class="m-item">{m}</span>)}
		</div>
	</div>

	<!-- Interactive funnel -->
	<section class="section">
		<div class="container-max">
			<p class="eyebrow center" data-reveal>Explore the funnel</p>
			<h2 class="center" data-reveal>Every buyer passes through three stages. Where are you leaking?</h2>
			<FunnelStages services={{ tofu: stageServices('ToFu'), mofu: stageServices('MoFu'), bofu: stageServices('BoFu') }} />
		</div>
	</section>

	<!-- Thesis timeline -->
	<section class="section alt timeline-section">
		<div class="container-max">
			<h2 class="center" data-reveal>We don&rsquo;t chase the medium. We engineer the funnel.</h2>
			<div class="timeline">
				{timeline.map((node, i) => (
					<div class:list={['timeline-node', { last: i === timeline.length - 1 }]} data-reveal>
						<p class="era">{node.era}</p>
						<p class="body">{node.body}</p>
					</div>
				))}
			</div>
			<p class="funnel-strip">Awareness &rarr; Consideration &rarr; Decision</p>
		</div>
	</section>

	<!-- What we report -->
	<section class="section report-section">
		<div class="container-max">
			<h2 class="center" data-reveal>What we actually report</h2>
			<div class="report-grid">
				<div class="report-col muted" data-reveal="left">
					<h3>What most agencies report</h3>
					<ul>
						<li>Impressions</li>
						<li>Sessions</li>
						<li>Bounce rate</li>
						<li>Domain authority</li>
						<li>Keyword count</li>
						<li>Social followers</li>
					</ul>
				</div>
				<div class="report-col bold" data-reveal="right">
					<h3>What we report</h3>
					<ul>
						<li>Qualified leads</li>
						<li>Pipeline value</li>
						<li>CAC</li>
						<li>Customer LTV</li>
						<li>Deal velocity</li>
						<li>Revenue attribution</li>
					</ul>
				</div>
			</div>
			<p class="caption center" data-reveal>One column makes a slide deck look good. The other pays your sales team.</p>
		</div>
	</section>

	<!-- Calculator -->
	<section class="section alt calc-section">
		<div class="container-max">
			<p class="eyebrow center" data-reveal>Free tool</p>
			<h2 class="center" data-reveal>What is your funnel actually worth?</h2>
			<p class="center lede" data-reveal>Drag the sliders. See what one point of conversion at each stage does to annual revenue.</p>
			<FunnelCalculator />
			<p class="center more-tools"><a href="/tools/funnel-revenue-calculator/" class="body-link">Open the full calculator &rarr;</a></p>
		</div>
	</section>

	<!-- Built for manufacturing -->
	<section class="section">
		<div class="container-max">
			<h2 class="center" data-reveal>Generalist agencies fail industrial brands. Here&rsquo;s why we don&rsquo;t.</h2>
			<div class="manufacturing-grid">
				{manufacturingCards.map((c) => (
					<div class="card" data-reveal>
						<h3>{c.title}</h3>
						<p>{c.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<!-- Services teaser -->
	<section class="section alt">
		<div class="container-max">
			<h2 class="center" data-reveal>Services built around the funnel</h2>
			<div class="service-grid">
				{services.map((s) => (
					<div data-reveal>
						<ServiceCard slug={s.id} title={s.data.title} funnelStages={s.data.funnelStages} oneLiner={s.data.oneLiner} />
					</div>
				))}
			</div>
			<p class="center"><a href="/services/" class="btn btn-secondary">Explore all services</a></p>
		</div>
	</section>

	<!-- Case studies -->
	<section class="section">
		<div class="container-max">
			<h2 class="center" data-reveal>Proof, not promises</h2>
			<div class="case-grid">
				{caseStudies.map((c) => (
					<div data-reveal>
						<CaseStudyCard
							slug={c.id}
							client={c.data.anonymized ? 'Industrial Revenue Recovery' : c.data.client}
							headlineMetric={c.data.headlineMetric}
							industryLabel={industryLabels[c.data.industry] ?? c.data.industry}
						/>
					</div>
				))}
			</div>
			<p class="center"><a href="/case-studies/" class="btn btn-secondary">See all case studies</a></p>
		</div>
	</section>

	<!-- AI era -->
	<section class="section ai-era">
		<div class="container-max ai-era-inner">
			<div data-reveal="left">
				<p class="eyebrow">Generative Engine Optimization</p>
				<h2>When your buyer asks ChatGPT, are you the answer?</h2>
				<p>
					Procurement engineers, plant managers, and R&amp;D heads now start vendor research inside Perplexity, ChatGPT, and Gemini &mdash; not Google. If your brand isn&rsquo;t cited there, you&rsquo;re not in the consideration set. We engineer LLM visibility the same way we engineered Google rankings ten years ago: with structured content, citation building, and technical optimisation.
				</p>
				<div class="ai-actions">
					<a href="/services/geo/" class="btn btn-accent">See how GEO works</a>
					<a href="/tools/ai-visibility-checker/" class="btn btn-ghost light">Test your AI visibility &rarr;</a>
				</div>
			</div>
			<div class="ai-era-card" data-reveal="right">
				<p class="eyebrow">Example prompt</p>
				<p class="prompt" data-type="“Who are the top vendors for industrial filtration in India?”">“Who are the top vendors for industrial filtration in India?”</p>
				<p class="prompt-note">If your brand isn&rsquo;t in the answer, you&rsquo;ve already lost the deal &mdash; before a human ever opened a browser.</p>
			</div>
		</div>
	</section>

	<!-- Tools -->
	<section class="section">
		<div class="container-max">
			<p class="eyebrow center" data-reveal>Free tools</p>
			<h2 class="center" data-reveal>Paste a URL. Get the diagnosis.</h2>
			<div class="tool-grid">
				{tools.map((t) => (
					<a href={`/tools/${t.id}/`} class="card tool" data-reveal>
						<span class="t-ico"><ToolIcon name={t.data.icon} size={24} /></span>
						<h3>{t.data.title}</h3>
						<p>{t.data.oneLiner}</p>
					</a>
				))}
			</div>
		</div>
	</section>

	<!-- Author -->
	{author && (
		<section class="section alt author-strip">
			<div class="container-max author-inner" data-reveal>
				<span class="avatar" aria-hidden="true">{author.data.name.split(' ').map((p) => p[0]).join('')}</span>
				<div>
					<p class="eyebrow">Who runs the work</p>
					<h2>{author.data.name}</h2>
					<p>{author.data.headline} Every engagement is led by the founder, not handed off after the pitch.</p>
					<a href="/author/" class="body-link">Meet the author &rarr;</a>
				</div>
			</div>
		</section>
	)}

	<!-- Trust signals -->
	<section class="section trust-section">
		<div class="container-max">
			<StatStrip
				dark
				stats={[
					{ value: '8+', label: 'Years scaling B2B and industrial brands' },
					{ value: '5×', label: 'Traffic uplift, agency-level average' },
					{ value: '3×', label: 'Revenue uplift, agency-level average' },
					{ value: '4,000+', label: 'Keywords optimised, 1,800+ in top 10' },
				]}
			/>
		</div>
	</section>

	<CTASection
		heading="Stop reporting traffic. Start reporting revenue."
		body="30 minutes. No deck. No pitch. We'll show you exactly where your funnel is leaking."
		primaryLabel="Get a free revenue audit"
	/>
</Layout>

<style>
	.sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

	/* Hero: the logo blue, with an orange glow that follows the funnel */
	.hero { position: relative; overflow: hidden; background: linear-gradient(160deg, var(--color-steel-700) 0%, var(--color-steel-900) 100%); color: white; padding-block: clamp(3rem, 8vw, 6rem) 0; }
	.hero .glow { position: absolute; width: 720px; height: 720px; right: -160px; top: -220px; background: radial-gradient(circle, rgba(232, 104, 12, 0.38), transparent 62%); pointer-events: none; }
	.hero-grid { position: relative; display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 3rem; align-items: center; }
	.hero-inner { max-width: 680px; }
	.hero .eyebrow { color: var(--color-amber-300); }
	.hero h1 { font-family: var(--font-display); font-weight: 900; font-size: clamp(2.4rem, 5.6vw, var(--text-display-1)); line-height: 1.04; color: white; margin: 0.75rem 0 1rem; letter-spacing: -0.01em; }
	.rotor { font-family: var(--font-display); font-size: clamp(1.4rem, 3vw, 2rem); font-weight: 600; color: white; margin: 0 0 1rem; }
	.rotor [data-rotate] { display: inline-block; font-weight: 900; }
	.hero .sub { font-size: var(--text-body-lg); color: var(--color-steel-100); max-width: 52ch; }
	.url-cta { display: flex; gap: 0.6rem; margin-top: 1.75rem; max-width: 560px; background: rgba(255,255,255,0.1); padding: 0.45rem; border-radius: 14px; border: 1px solid rgba(255,255,255,0.22); backdrop-filter: blur(6px); }
	.url-cta .field-input { border: 0; background: white; flex: 1; min-width: 0; }
	.url-cta .btn { white-space: nowrap; }
	.micro { font-size: 0.8rem; color: var(--color-steel-100); margin: 0.6rem 0 0; opacity: 0.85; }
	.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; }
	.hero-actions .btn-secondary { color: white; border-color: rgba(255,255,255,0.75); }
	.hero-actions .btn-secondary:hover { background: rgba(255,255,255,0.12); }
	.hero-actions .btn-ghost { color: var(--color-amber-300); }
	.hero-art { position: relative; }

	.proof-row { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-top: clamp(2.5rem, 5vw, 4rem); padding-block: 1.75rem; border-top: 1px solid rgba(255,255,255,0.18); }
	.proof-row div { display: grid; gap: 0.15rem; }
	.proof-row b { font-family: var(--font-display); font-weight: 900; font-size: clamp(1.6rem, 3.2vw, 2.4rem); color: var(--color-amber-300); line-height: 1.1; }
	.proof-row span { font-size: 0.85rem; color: var(--color-steel-100); }

	.band { background: var(--color-amber-700); color: white; padding-block: 0.9rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; font-size: 0.8rem; }
	.m-item { white-space: nowrap; }
	.m-item::after { content: '◆'; margin-left: 3rem; color: var(--color-amber-300); }

	.center { text-align: center; }
	.lede { color: var(--color-charcoal-700); margin: -1rem auto 2rem; font-size: var(--text-body-lg); }
	.section h2 { font-size: var(--text-h2); margin-bottom: 2rem; }
	.section .eyebrow.center { margin-bottom: 0.5rem; }
	.section.alt { background: var(--color-charcoal-100); }
	.more-tools { margin-top: 2rem; }

	.timeline { display: grid; grid-template-columns: repeat(6, minmax(180px, 1fr)); gap: 1rem; overflow-x: auto; padding: 0.5rem 0.25rem 1rem; position: relative; }
	.timeline-node { background: white; border: 1px solid var(--color-charcoal-300); border-radius: var(--radius-lg); padding: 1.25rem; transition: transform 250ms, border-color 250ms, box-shadow 250ms; }
	.timeline-node:hover { transform: translateY(-6px); border-color: var(--color-amber-700); box-shadow: var(--shadow-lg); }
	.timeline-node.last { background: var(--color-steel-700); border-color: var(--color-steel-700); }
	.timeline-node.last .era { color: var(--color-amber-300); }
	.timeline-node.last .body { color: white; }
	.timeline-node .era { font-weight: 700; color: var(--color-steel-700); margin-bottom: 0.5rem; font-size: 0.9rem; }
	.timeline-node .body { font-size: 0.85rem; color: var(--color-charcoal-700); margin: 0; }
	.funnel-strip { text-align: center; margin-top: 1.5rem; font-family: var(--font-sans); font-weight: 700; color: var(--color-amber-700); letter-spacing: 0.02em; }

	.report-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; max-width: 760px; margin-inline: auto; }
	.report-col { border-radius: var(--radius-lg); padding: 1.75rem; }
	.report-col.muted { background: var(--color-charcoal-100); color: var(--color-charcoal-500); }
	.report-col.bold { background: var(--color-steel-700); color: white; box-shadow: var(--shadow-lg); }
	.report-col h3 { font-size: var(--text-h4); margin-bottom: 1rem; }
	.report-col.muted h3 { color: var(--color-charcoal-700); }
	.report-col.muted li { text-decoration: line-through; text-decoration-color: rgba(107, 104, 98, 0.5); }
	.report-col.bold h3 { color: white; }
	.report-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.95rem; }
	.report-col.bold li::before { content: '✓ '; color: var(--color-amber-300); font-weight: 800; }
	.caption { margin-top: 1.5rem; color: var(--color-charcoal-500); font-style: italic; }

	.manufacturing-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
	.manufacturing-grid .card h3 { font-size: var(--text-h4); margin-bottom: 0.5rem; }
	.manufacturing-grid .card p { color: var(--color-charcoal-700); margin: 0; }
	.manufacturing-grid .card { border-top: 3px solid transparent; }
	.manufacturing-grid .card:hover { border-top-color: var(--color-amber-700); }

	.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem; }
	.case-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 2rem; }

	.ai-era { background: var(--color-steel-900); color: white; }
	.ai-era-inner { display: grid; grid-template-columns: 1.2fr 1fr; gap: 3rem; align-items: center; }
	.ai-era h2 { color: white; font-size: var(--text-h2); margin: 0.5rem 0 1rem; }
	.ai-era .eyebrow { color: var(--color-amber-300); }
	.ai-era p { color: var(--color-steel-100); margin-bottom: 1.5rem; }
	.ai-actions { display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; }
	.btn-ghost.light { color: var(--color-amber-300); }
	.ai-era-card { background: var(--color-steel-700); border-radius: var(--radius-lg); padding: 1.75rem; border: 1px solid rgba(255,255,255,0.12); }
	.ai-era-card .eyebrow { color: var(--color-amber-300); }
	.ai-era-card .prompt { font-family: var(--font-display); font-style: italic; font-size: var(--text-h4); color: white; margin: 0.5rem 0 1rem; min-height: 4.2em; }
	.ai-era-card .prompt.typing::after { content: '▍'; color: var(--color-amber-300); animation: blink 1s steps(1) infinite; }
	@keyframes blink { 50% { opacity: 0; } }
	.ai-era-card .prompt-note { font-size: 0.85rem; color: var(--color-steel-100); margin: 0; }

	.tool-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
	.tool { text-decoration: none; display: grid; gap: 0.5rem; align-content: start; }
	.tool h3 { font-size: 1.05rem; margin: 0.5rem 0 0; }
	.tool p { font-size: 0.88rem; color: var(--color-charcoal-500); margin: 0; }
	.t-ico { width: 46px; height: 46px; border-radius: 12px; display: grid; place-content: center; background: var(--color-steel-700); color: white; transition: background 250ms, transform 250ms; }
	.tool:hover .t-ico { background: var(--color-amber-700); transform: rotate(-6deg); }

	.author-inner { display: flex; gap: 2rem; align-items: center; max-width: 820px; }
	.avatar { flex: none; width: 110px; height: 110px; border-radius: 50%; display: grid; place-content: center; background: var(--color-steel-700); color: white; font-family: var(--font-display); font-weight: 900; font-size: 2.6rem; box-shadow: 0 0 0 6px var(--color-amber-100), 0 0 0 8px var(--color-amber-700); }
	.author-strip h2 { margin-bottom: 0.5rem; }
	.author-strip p { margin: 0 0 0.75rem; color: var(--color-charcoal-700); }

	.trust-section { background: var(--color-steel-900); padding-top: 3rem; }

	@media (max-width: 1000px) {
		.hero-grid { grid-template-columns: 1fr; }
		.hero-art { max-width: 420px; margin-inline: auto; width: 100%; }
		.tool-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 900px) {
		.report-grid, .manufacturing-grid, .service-grid, .case-grid { grid-template-columns: 1fr; }
		.ai-era-inner { grid-template-columns: 1fr; }
		.proof-row { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 560px) {
		.url-cta { flex-direction: column; }
		.tool-grid { grid-template-columns: 1fr; }
		.author-inner { flex-direction: column; text-align: center; }
	}
</style>

<script>
	// Typewriter for the example AI prompt, started when it scrolls into view.
	const el = document.querySelector<HTMLElement>('.prompt[data-type]');
	if (el && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const full = el.dataset.type ?? '';
		el.textContent = '';
		el.classList.add('typing');
		new IntersectionObserver((entries, obs) => {
			if (!entries[0].isIntersecting) return;
			obs.disconnect();
			let i = 0;
			const id = setInterval(() => {
				el.textContent = full.slice(0, ++i);
				if (i >= full.length) { clearInterval(id); el.classList.remove('typing'); }
			}, 38);
		}, { threshold: 0.6 }).observe(el);
	}
</script>
