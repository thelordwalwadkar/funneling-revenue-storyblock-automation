# Copy this file to .env and fill in your own values. .env is gitignored —
# never commit real tokens. For CI, set these as GitHub Actions repository
# secrets instead (Settings -> Secrets and variables -> Actions).

# Storyblok Management API (account-level Personal Access Token, not a space
# preview token). Create at: My Account -> Personal Access Tokens.
STORYBLOK_MANAGEMENT_TOKEN=

# Numeric space ID, from Space Settings -> General in Storyblok.
STORYBLOK_SPACE_ID=

# Optional. Only set this if your space's data residency isn't the EU default
# (Space Settings -> General shows the region). One of: eu (default), us, ca, ap, cn.
STORYBLOK_REGION=

# ---------------------------------------------------------------------------
# Site backend (tools + lead capture). All optional: the site runs with none.
# ---------------------------------------------------------------------------

# Where submissions.jsonl is written. Point at a persistent disk / volume.
DATA_DIR=./data

# Protects /admin/ and /api/submissions/. Use a long random string.
ADMIN_TOKEN=

# Where new leads and tool runs are sent the moment they happen. Slack,
# Discord, Mattermost, Zapier and Make all accept this format.
WEBHOOK_URL=

# Optional email alerts via Resend (https://resend.com). NOTIFY_EMAIL may be comma-separated.
RESEND_API_KEY=
NOTIFY_EMAIL=
MAIL_FROM=

# Salt for hashing visitor IPs before they are stored.
IP_SALT=

# ---------------------------------------------------------------------------
# Storyblok -> site automation (see README, "Content automation")
# ---------------------------------------------------------------------------
# Secret you also paste into the Storyblok webhook settings.
STORYBLOK_WEBHOOK_SECRET=
# A GitHub token with repo scope + "owner/repo". Triggers the pull workflow.
GITHUB_TOKEN=
GITHUB_REPO=
# Alternative / extra: a host deploy hook URL that rebuilds the site.
DEPLOY_HOOK_URL=
