---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import StatStrip from '../../components/StatStrip.astro';
import CTASection from '../../components/CTASection.astro';
import FunnelExplorer from '../../components/FunnelExplorer.astro';
import { getCollection, getEntry } from 'astro:content';
import { articleSchema, breadcrumbSchema } from '../../lib/schema';

export async function getStaticPaths() {
	const caseStudies = await getCollection('caseStudies');
	return caseStudies.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const path = `/case-studies/${entry.id}/`;

const industry = await getEntry('industries', data.industry);
const services = await Promise.all(data.servicesUsed.map((s) => getEntry('services', s)));
const nextCase = await getEntry('caseStudies', data.nextCaseStudy);
const author = (await getCollection('authors'))[0];
const displayName = data.anonymized ? 'Industrial Revenue Recovery' : data.client;
---

<Layout
	title={data.metaTitle}
	description={data.metaDescription}
	path={path}
	ogType="article"
	stickyCta
	schema={[
		articleSchema({ headline: data.h1, description: data.metaDescription, path }),
		breadcrumbSchema([
			{ name: 'Home', path: '/' },
			{ name: 'Case Studies', path: '/case-studies/' },
			{ name: displayName, path },
		]),
	]}
>
	<div class="container-max crumbs">
		<Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Case Studies', path: '/case-studies/' }, { name: displayName, path }]} />
	</div>

	<section class="header-strip">
		<div class="container-max">
			<div class="meta-row">
				<a href={`/industries/${industry.id}/`} class="pill">{industry.data.title}</a>
				{services.map((s) => <a href={`/services/${s.id}/`} class="pill">{s.data.title}</a>)}
				<span class="pill pill-static">{data.engagementDuration}</span>
			</div>
			<h1>{data.h1}</h1>
			{author && (
				<p class="byline">
					By <a href="/author/">{author.data.name}</a>, {author.data.role}
				</p>
			)}
			{data.anonymized && data.anonymizedNote && <p class="anon-note">{data.anonymizedNote}</p>}
			<StatStrip dark stats={data.metrics} />
		</div>
	</section>

	<section class="section explorer-section">
		<div class="container-max">
			<h2 class="center" data-reveal>The funnel, before and after</h2>
			<p class="center lede" data-reveal>Flip between where the funnel was leaking, what we changed at each stage, and where it ended up.</p>
			<FunnelExplorer before={data.funnelBefore} after={data.funnelAfter} actions={data.actionsByStage} />
		</div>
	</section>

	<section class="section alt">
		<div class="container-max container-reading">
			<h2>Revenue impact</h2>
			<p class="prose-body impact">{data.revenueImpact}</p>
			{data.quote && <blockquote class="prose-body">{data.quote}</blockquote>}
		</div>
	</section>

	<section class="section">
		<div class="container-max container-reading">
			<h2>What we&rsquo;d do differently with AI today</h2>
			<p class="prose-body">{data.aiToday}</p>
		</div>
	</section>

	<section class="section alt next-case">
		<div class="container-max container-reading">
			<p class="eyebrow">Next case study</p>
			<a href={`/case-studies/${nextCase.id}/`} class="next-link">
				{nextCase.data.anonymized ? 'Industrial Revenue Recovery' : nextCase.data.client}: {nextCase.data.headlineMetric} &rarr;
			</a>
		</div>
	</section>

	<CTASection heading="Get a free audit like this one." primaryLabel="Request a free audit" />
</Layout>

<style>
	.crumbs { padding-top: 1.5rem; }
	.header-strip { background: var(--color-steel-900); color: white; padding-block: 2rem 3rem; }
	.meta-row { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 1.25rem; }
	.pill {
		font-size: 0.8rem; font-weight: 600;
		padding: 0.35rem 0.85rem;
		border-radius: 999px;
		background: var(--color-steel-700);
		color: white;
		text-decoration: none;
	}
	.pill:hover { background: var(--color-steel-500); }
	.pill-static { background: transparent; border: 1px solid var(--color-steel-500); }
	.header-strip h1 { color: white; font-size: clamp(1.75rem, 4vw, var(--text-h1)); max-width: 800px; margin-bottom: 1.5rem; }
	.byline { color: var(--color-steel-100); font-size: 0.9rem; margin: -0.75rem 0 1.5rem; }
	.byline a { color: var(--color-amber-300); font-weight: 600; text-underline-offset: 3px; }
	.lede { color: var(--color-charcoal-500); margin: -1rem auto 2rem; }
	.explorer-section h2 { margin-bottom: 1.5rem; }
	.anon-note { color: var(--color-steel-100); font-size: 0.85rem; font-style: italic; margin-bottom: 1.5rem; max-width: 60ch; }

	.section.alt { background: var(--color-charcoal-100); }
	.center { text-align: center; }



	.impact { font-size: var(--text-body-lg); }
	.next-case .next-link { font-family: var(--font-display); font-weight: 700; font-size: var(--text-h3); color: var(--color-steel-900); text-decoration: none; }
	.next-case .next-link:hover { color: var(--color-steel-700); }

	@media (max-width: 900px) {
		}
</style>
