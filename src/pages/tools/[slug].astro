---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTASection from '../../components/CTASection.astro';
import UrlTool from '../../components/UrlTool.astro';
import FunnelCalculator from '../../components/FunnelCalculator.astro';
import ToolIcon from '../../components/ToolIcon.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, faqPageSchema, softwareToolSchema } from '../../lib/schema';

export async function getStaticPaths() {
	const tools = await getCollection('tools');
	return tools.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { data } = entry;
const path = `/tools/${entry.id}/`;
const others = (await getCollection('tools')).filter((t) => t.id !== entry.id).sort((a, b) => a.data.order - b.data.order);
---

<Layout
	title={data.metaTitle}
	description={data.metaDescription}
	path={path}
	schema={[
		softwareToolSchema({ name: data.title, description: data.metaDescription, path }),
		faqPageSchema(data.faq),
		breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }, { name: data.title, path }]),
	]}
>
	<div class="container-max crumbs">
		<Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Tools', path: '/tools/' }, { name: data.title, path }]} />
	</div>

	<section class="top">
		<div class="container-max">
			<span class="ico" data-reveal><ToolIcon name={data.icon} size={26} /></span>
			<h1 data-reveal>{data.h1}</h1>
			<p class="sub" data-reveal>{data.oneLiner}</p>
		</div>
	</section>

	<section class="section work">
		<div class="container-max">
			{data.kind === 'url' ? (
				<div class="tool-shell card-ish">
					<UrlTool toolId={data.toolId} label={data.inputLabel} placeholder={data.inputPlaceholder} button={data.buttonLabel} />
				</div>
			) : (
				<FunnelCalculator />
			)}
		</div>
	</section>

	<section class="section alt">
		<div class="container-max info">
			<div data-reveal>
				<h2>What you get</h2>
				<ul class="ticks">{data.whatYouGet.map((w) => <li>{w}</li>)}</ul>
			</div>
			<div data-reveal>
				<h2>How it works</h2>
				<ol class="steps">
					{data.howItWorks.map((s) => (
						<li><strong>{s.title}</strong><span>{s.body}</span></li>
					))}
				</ol>
			</div>
		</div>
	</section>

	<section class="section">
		<div class="container-max container-reading">
			<h2>Frequently asked questions</h2>
			<FAQAccordion faq={data.faq} />
		</div>
	</section>

	<section class="section alt">
		<div class="container-max">
			<h2 class="center">More free tools</h2>
			<div class="more">
				{others.map((t) => (
					<a href={`/tools/${t.id}/`} class="card more-card" data-reveal>
						<span class="mi"><ToolIcon name={t.data.icon} size={22} /></span>
						<div><h3>{t.data.title}</h3><p>{t.data.oneLiner}</p></div>
					</a>
				))}
			</div>
		</div>
	</section>

	<CTASection heading="Found something worth fixing?" body="The tool shows the leaks. The 30-minute audit shows which one to fix first." primaryLabel="Get a free revenue audit" />
</Layout>

<style>
	.crumbs { padding-top: 1.5rem; }
	.top { padding-block: 2rem 0.5rem; }
	.ico { display: inline-grid; place-content: center; width: 52px; height: 52px; border-radius: 14px; background: var(--color-steel-700); color: white; margin-bottom: 1rem; animation: float-y 5s ease-in-out infinite; }
	.top h1 { font-size: clamp(1.9rem, 4.2vw, var(--text-h1)); max-width: 22ch; margin: 0 0 0.75rem; }
	.sub { font-size: var(--text-body-lg); color: var(--color-charcoal-700); max-width: 60ch; }
	.work { padding-top: 1.5rem; }
	.tool-shell { background: white; border-radius: var(--radius-xl); box-shadow: var(--shadow-md); padding: clamp(1.25rem, 3vw, 2rem); border-top: 4px solid var(--color-amber-700); }
	.section.alt { background: var(--color-charcoal-100); }
	.center { text-align: center; }
	.info { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; }
	.info h2, .section h2 { font-size: var(--text-h2); margin-bottom: 1.25rem; }
	.ticks { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.75rem; }
	.ticks li { position: relative; padding-left: 2rem; color: var(--color-charcoal-700); }
	.ticks li::before { content: '✓'; position: absolute; left: 0; top: 0; width: 22px; height: 22px; border-radius: 50%; background: var(--color-amber-100); color: var(--color-amber-700); font-weight: 800; display: grid; place-content: center; font-size: 0.8rem; }
	.steps { list-style: none; counter-reset: s; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
	.steps li { counter-increment: s; position: relative; padding-left: 3rem; display: grid; gap: 0.2rem; }
	.steps li::before { content: counter(s); position: absolute; left: 0; top: 0; width: 34px; height: 34px; border-radius: 50%; background: var(--color-steel-700); color: white; font-family: var(--font-display); font-weight: 900; display: grid; place-content: center; }
	.steps strong { color: var(--color-steel-900); }
	.steps span { color: var(--color-charcoal-700); font-size: 0.95rem; }
	.more { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.more-card { display: flex; gap: 1rem; text-decoration: none; padding: 1.25rem; }
	.mi { flex: none; width: 44px; height: 44px; border-radius: 12px; background: var(--color-steel-100); color: var(--color-steel-700); display: grid; place-content: center; }
	.more-card h3 { font-size: 1.05rem; margin: 0 0 0.25rem; }
	.more-card p { font-size: 0.85rem; color: var(--color-charcoal-500); margin: 0; }
	@media (max-width: 900px) { .info, .more { grid-template-columns: 1fr; } }
</style>
