---
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const industries = (await getCollection('industries')).sort((a, b) => a.data.order - b.data.order);
const pillars = (await getCollection('pillars')).sort((a, b) => a.data.order - b.data.order);
const tools = (await getCollection('tools')).sort((a, b) => a.data.order - b.data.order);
---

<header class="site-header">
	<div class="container-max bar">
		<a href="/" class="wordmark" aria-label="Funneling Revenue — home">
			<img src="/brand/fr-mark.png" alt="" width="64" height="40" class="logo-mark" />
			<span class="wordmark-text">Funneling Revenue</span>
		</a>

		<button id="nav-toggle" class="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
			<span class="sr-only">Menu</span>
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
				<path d="M3 6h18M3 12h18M3 18h18" stroke-linecap="round" />
			</svg>
		</button>

		<nav id="primary-nav" class="primary-nav" aria-label="Primary">
			<ul>
				<li class="has-dropdown">
					<a href="/services/">Services</a>
					<ul class="dropdown">
						{services.map((s) => (
							<li>
								<a href={`/services/${s.id}/`}>
									{s.data.title}
									<span class="funnel-tag" style="margin-left:8px;">{s.data.funnelStages[0]}</span>
								</a>
							</li>
						))}
					</ul>
				</li>
				<li class="has-dropdown">
					<a href="/industries/">Industries</a>
					<ul class="dropdown">
						{industries.map((i) => (
							<li><a href={`/industries/${i.id}/`}>{i.data.title}</a></li>
						))}
					</ul>
				</li>
				<li><a href="/case-studies/">Case Studies</a></li>
				<li class="has-dropdown">
					<a href="/tools/">Free Tools</a>
					<ul class="dropdown">
						{tools.map((t) => (
							<li><a href={`/tools/${t.id}/`}>{t.data.title}</a></li>
						))}
						<li><a href="/tools/">All tools</a></li>
					</ul>
				</li>
				<li class="has-dropdown">
					<a href="/insights/">Insights</a>
					<ul class="dropdown">
						{pillars.map((p) => (
							<li><a href={`/insights/pillar/${p.id}/`}>{p.data.title}</a></li>
						))}
						<li><a href="/insights/">All Insights</a></li>
					</ul>
				</li>
				<li><a href="/author/">Author</a></li>
			</ul>
			<a href="https://www.linkedin.com/in/seo-shubham/" class="nav-linkedin" target="_blank" rel="me noopener noreferrer" aria-label="Shubham Walwadkar on LinkedIn">
				<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"/></svg>
				<span class="nav-linkedin-label">LinkedIn</span>
			</a>
			<a href="/audit/" class="btn btn-accent nav-cta">Get a free audit</a>
		</nav>
		<div class="nav-backdrop" id="nav-backdrop" aria-hidden="true"></div>
	</div>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(252, 252, 251, 0.92);
		backdrop-filter: saturate(1.4) blur(10px);
		border-bottom: 1px solid var(--color-charcoal-300);
	}
	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding-block: 1rem;
	}
	.wordmark {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		text-decoration: none;
	}
	.logo-mark { display: block; width: 64px; height: 40px; }
	.wordmark-text {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 1.35rem;
		line-height: 1;
		letter-spacing: -0.01em;
		color: var(--color-steel-700);
		white-space: nowrap;
	}

	.nav-linkedin {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--color-steel-700);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.nav-linkedin:hover { color: var(--color-amber-700); }
	.nav-linkedin-label { display: none; }
	.nav-backdrop { display: none; }

	.nav-toggle {
		display: none;
		background: none;
		border: none;
		color: var(--color-steel-900);
		padding: 0.5rem;
		cursor: pointer;
	}
	.sr-only {
		position: absolute;
		width: 1px; height: 1px;
		overflow: hidden;
		clip: rect(0 0 0 0);
	}

	.primary-nav {
		display: flex;
		align-items: center;
		gap: 2rem;
	}
	.primary-nav > ul {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.primary-nav > ul > li > a {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 0.95rem;
		color: var(--color-charcoal-900);
		text-decoration: none;
		padding-block: 1.6rem;
	}
	.primary-nav > ul > li > a:hover { color: var(--color-steel-700); }

	.has-dropdown { position: relative; }
	.dropdown {
		position: absolute;
		top: 100%;
		left: -1rem;
		min-width: 280px;
		background: white;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-lg);
		list-style: none;
		margin: 0;
		padding: 0.5rem;
		opacity: 0;
		visibility: hidden;
		transform: translateY(4px);
		transition: opacity 150ms ease, transform 150ms ease, visibility 150ms;
	}
	.has-dropdown:hover .dropdown,
	.has-dropdown:focus-within .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
	}
	.dropdown li a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.6rem 0.75rem;
		border-radius: var(--radius-sm);
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--color-charcoal-900);
		text-decoration: none;
		white-space: nowrap;
	}
	.dropdown li a:hover { background: var(--color-steel-100); }

	.nav-cta { white-space: nowrap; padding: 10px 20px; font-size: 0.9rem; }

	@media (max-width: 1100px) {
		.nav-toggle { display: inline-flex; }
		.primary-nav {
			position: fixed;
			/* The header's backdrop-filter makes it the containing block, so a
			   bottom: 0 inset collapsed the menu to a 48px strip. Size it explicitly. */
			/* Side panel on the right; the dimmed page stays visible on the left. */
			inset: 73px 0 auto auto;
			width: min(400px, 86vw);
			height: calc(100vh - 73px);
			height: calc(100dvh - 73px);
			z-index: 2;
			background: var(--color-off-white);
			border-left: 1px solid var(--color-charcoal-300);
			box-shadow: -12px 0 32px rgba(20, 54, 80, 0.18);
			flex-direction: column;
			align-items: stretch;
			padding: 1.5rem;
			gap: 1.5rem;
			/* Closed: wiped away with clip-path while staying inside the screen.
			   Parking it off-screen with translateX(100%) made phones zoom out to
			   fit it, so the whole page could be swiped sideways. */
			clip-path: inset(0 0 0 100%);
			visibility: hidden;
			transition: clip-path 200ms ease, visibility 0s linear 200ms;
			overflow-y: auto;
		}
		.primary-nav.open { clip-path: inset(0 0 0 -40px); visibility: visible; transition: clip-path 200ms ease; }
		.nav-backdrop {
			display: block;
			position: fixed;
			inset: 73px 0 auto 0;
			height: calc(100vh - 73px);
			height: calc(100dvh - 73px);
			z-index: 1;
			background: rgba(15, 33, 48, 0.45);
			opacity: 0;
			visibility: hidden;
			transition: opacity 200ms ease, visibility 0s linear 200ms;
		}
		.primary-nav.open + .nav-backdrop { opacity: 1; visibility: visible; transition: opacity 200ms ease; }
		.nav-linkedin { padding-block: 0.25rem; }
		.nav-linkedin-label { display: inline; }
		.primary-nav > ul { flex-direction: column; align-items: stretch; gap: 0; }
		.primary-nav > ul > li > a { display: block; padding-block: 0.9rem; border-bottom: 1px solid var(--color-charcoal-300); }
		.dropdown {
			position: static;
			opacity: 1; visibility: visible; transform: none;
			box-shadow: none; background: var(--color-charcoal-100);
			display: none;
		}
		.has-dropdown.open .dropdown { display: block; }
		.nav-cta { text-align: center; justify-content: center; margin-top: 0.5rem; }
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const nav = document.getElementById('primary-nav');
	const setOpen = (open: boolean) => {
		nav?.classList.toggle('open', open);
		toggle?.setAttribute('aria-expanded', String(open));
	};
	toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('open')));
	// Tapping the dimmed page or pressing Escape closes the side panel.
	document.getElementById('nav-backdrop')?.addEventListener('click', () => setOpen(false));
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && nav?.classList.contains('open')) { setOpen(false); toggle?.focus(); }
	});

	if (window.matchMedia('(max-width: 1100px)').matches) {
		document.querySelectorAll('.has-dropdown > a').forEach((link) => {
			link.addEventListener('click', (e) => {
				if (window.innerWidth <= 1100) {
					e.preventDefault();
					link.parentElement?.classList.toggle('open');
				}
			});
		});
	}
</script>
