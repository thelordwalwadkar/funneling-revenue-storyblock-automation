---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema, collectionPageSchema } from '../../lib/schema';

const path = '/services/';
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

// What every service on this page is set up to do, in the order manufacturers ask for it.
const commitments = [
	{ title: 'A written roadmap first', body: 'Before any retainer starts you get a plan: what we fix first, what it should move and what we will not do. No spend out of FOMO.' },
	{ title: 'Reports in plain language', body: 'Crawling, indexing and impressions are explained in plant and product terms, then tied to enquiries, RFQs and pipeline.' },
	{ title: 'You own the data', body: 'Analytics, Search Console, ad accounts and dashboards are set up in your name, so you are never tied to us to see your own numbers.' },
	{ title: 'Small tools before big budgets', body: 'Our free audit, AI visibility checker and funnel calculator show what is worth fixing, and bring in enquiries without a media budget.' },
];
---

<Layout
	title="Digital Marketing for Manufacturing Industry | Services"
	description="Digital marketing for manufacturing industry brands: SEO, GEO, content, paid media and fractional leadership, on a clear roadmap with plain-English reports."
	path={path}
	schema={[
		collectionPageSchema({
			name: 'Services',
			description: 'Six revenue-driven services for industrial brands, each mapped to a funnel stage.',
			path,
		}),
		breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Services', path }]),
	]}
>
	<div class="container-max crumbs">
		<Breadcrumbs items={[{ name: 'Home', path: '/' }, { name: 'Services', path: '/services/' }]} />
	</div>

	<section class="hero-section">
		<div class="container-max container-reading">
			<h1>Digital Marketing for the Manufacturing Industry, Built Around the Funnel</h1>
			<p>
				Digital marketing for manufacturing companies goes wrong when it is built around channels instead of buyers. Our industrial digital marketing services start with the funnel. If you&rsquo;re losing deals at the top, you have a discovery problem. If you&rsquo;re losing them in the middle, you have a consideration problem. If you&rsquo;re losing them at the bottom, you have a conversion problem. Pick the service that matches your bottleneck &mdash; or talk to us and we&rsquo;ll diagnose it for you.
			</p>
			<p>
				Plenty of manufacturers have already been through an agency that sent jargon instead of answers, sold a retainer without a roadmap and kept the data. Every service below is set up the other way round.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="container-max service-grid">
			{services.map((s) => (
				<ServiceCard slug={s.id} title={s.data.title} oneLiner={s.data.oneLiner} />
			))}
		</div>
	</section>

	<section class="section alt">
		<div class="container-max">
			<h2 class="center">How every service works</h2>
			<div class="commit-grid">
				{commitments.map((c) => (
					<div class="card commit">
						<h3>{c.title}</h3>
						<p>{c.body}</p>
					</div>
				))}
			</div>
		</div>
	</section>

	<CTASection heading="Pick a service, or let us pick one for you." primaryLabel="Get a free audit" secondaryLabel="Browse case studies" secondaryHref="/case-studies/" />
</Layout>

<style>
	.crumbs { padding-top: 1.5rem; }
	.hero-section { padding-block: 2rem 1rem; }
	.hero-section h1 { font-size: clamp(2rem, 4vw, var(--text-h1)); margin-bottom: 1rem; }
	.hero-section p { color: var(--color-charcoal-700); font-size: var(--text-body-lg); }
	.hero-section p + p { margin-top: 1rem; }
	.section h2 { font-size: var(--text-h2); margin-bottom: 1.5rem; }
	.commit-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; }
	.commit.card { border-top: 3px solid transparent; }
	.commit.card:hover { border-top-color: var(--color-amber-700); }
	.commit h3 { font-size: var(--text-h4); margin-bottom: 0.5rem; }
	.commit p { color: var(--color-charcoal-700); font-size: 0.92rem; margin: 0; }
	.service-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
	.section.alt { background: var(--color-charcoal-100); }
	.center { text-align: center; }

	@media (max-width: 1000px) {
		.commit-grid { grid-template-columns: repeat(2, 1fr); }
	}
	@media (max-width: 900px) {
		.service-grid { grid-template-columns: 1fr; }
	}
	@media (max-width: 560px) {
		.commit-grid { grid-template-columns: 1fr; }
	}
</style>
