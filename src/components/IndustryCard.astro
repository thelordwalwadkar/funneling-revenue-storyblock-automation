---
interface Props {
	slug: string;
	title: string;
	oneLiner: string;
}
const { slug, title, oneLiner } = Astro.props;
---

<a href={`/industries/${slug}/`} class="industry-card card">
	<h3>{title}</h3>
	<p>{oneLiner}</p>
	<span class="link">Learn more &rarr;</span>
</a>

<style>
	.industry-card {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		text-decoration: none;
		border-top: 3px solid var(--color-steel-700);
		transition: transform 150ms ease, box-shadow 150ms ease;
	}
	.industry-card:hover {
		transform: translateY(-3px);
		box-shadow: var(--shadow-lg);
	}
	.industry-card h3 { font-size: var(--text-h4); }
	.industry-card p { color: var(--color-charcoal-700); font-size: 0.92rem; margin: 0; }
	.link { color: var(--color-steel-700); font-weight: 600; font-size: 0.9rem; margin-top: auto; }
</style>
